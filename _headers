/*
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# Cloudflare Pages Jekyll'i --safe ile çalıştırır; _plugins/ yüklenmez.
# Dosya adları sürümlenmediği için 1 yıllık immutable bayat CSS/JS bırakır.
# 1 günlük TTL + arka planda yenileme güvenli ve tekrar ziyaretleri hızlandırır.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Expo uygulamasının sürüm kontrolü için statik JSON uç noktaları.
# Manifest sık kontrol edilir; içerik paketinin version alanı manifest ile
# eşleşmediğinde uygulama paketi yeniden indirir.
/app/manifest.json
  Cache-Control: public, max-age=300

/app/content.json
  Cache-Control: public, max-age=300
