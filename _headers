/*
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# /assets/ URL'leri _plugins/version_assets.rb tarafından içerik özetiyle
# sürümlenir (?v=...); dosya değiştiğinde URL değişir. Bu yüzden 1 yıllık
# immutable güvenli, tekrar ziyaretler önbellekten karşılanır.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
