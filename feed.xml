---
layout: null
permalink: /feed.xml
redirect_from:
  - /feed
  - /feed/
  - /blog/feed
  - /blog/feed/
---
<?xml version="1.0" encoding="UTF-8" ?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
    <channel>
        <title>{{ site.title | xml_escape }}</title>
        <description>{{ site.description | xml_escape }}</description>
        <link>{{ site.url }}</link>
        <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
        <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>

        {% assign empty_array = "" | split: "" %}
        {% assign notes = site.notes | default: empty_array %}
        {% assign articles = site.articles | default: empty_array %}
        {% assign en_articles = site.en_articles | default: empty_array %}
        {% assign books = site.books | default: empty_array %}
        {% assign videos = site.videos | default: empty_array %}
        {% assign places = site.places | default: empty_array %}
        {% assign all_items = notes | concat: articles | concat: en_articles | concat: books | concat: videos | concat: places | sort: 'date' | reverse %}

        {% for item in all_items %}
        <item>
            <title>{% if item.title %}{{ item.title | xml_escape }}{% else %}Entry #{{ forloop.rindex }}{% endif %}</title>
            <description>{{ item.content | xml_escape }}</description>
            <pubDate>{{ item.date | date_to_rfc822 }}</pubDate>
            <link>{{ item.url | absolute_url }}</link>
            <guid isPermaLink="true">{{ item.url | absolute_url }}</guid>
        </item>
        {% endfor %}
    </channel>
</rss>
