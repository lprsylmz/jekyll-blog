{
  "name": "alpersoylemez.com",
  "title": "Alper Söylemez",
  "description": "Alper Söylemez kişisel sitesindeki yazı, journal notu, kitap, gezinti (yer) ve izlence içeriklerini ajanlara açan WebMCP araç tanımları.",
  "websiteUrl": "https://alpersoylemez.com",
  "version": "1.0.0",
  "tools": [
    {
      "name": "search_content",
      "description": "Blog yazıları, journal notları, kitaplık, gezinti (yerler) ve izlence kayıtlarında tam metin araması yapar; eşleşen başlık, adres ve özetleri döndürür.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "description": "Aranacak kelime veya ifade. En az iki karakter olmalıdır."
          },
          "collection": {
            "type": "string",
            "enum": ["all", "articles", "notes", "books", "places", "videos"],
            "default": "all",
            "description": "Aramanın sınırlandırılacağı koleksiyon. all tüm koleksiyonları tarar."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 8,
            "description": "Döndürülecek sonuç sayısı."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query", "collection", "count", "results"],
        "properties": {
          "query": { "type": "string" },
          "collection": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 },
          "error": { "type": "string" },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "url", "collection"],
              "properties": {
                "title": { "type": "string" },
                "url": { "type": "string" },
                "date": { "type": "string" },
                "author": { "type": "string" },
                "collection": {
                  "type": "string",
                  "enum": ["articles", "notes", "books", "places", "videos", "other"]
                }
              }
            }
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "untrustedContentHint": true,
        "consequentialHint": false
      }
    },
    {
      "name": "list_site_sections",
      "description": "Sitenin ajanların gezebileceği ana bölümlerini, keşif dosyalarını ve içerik indekslerini listeler.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "untrustedContentHint": false,
        "consequentialHint": false
      }
    },
    {
      "name": "get_site_overview",
      "description": "LLM'ler için hazırlanmış llms.txt içeriğini okur; site yapısı ve öncelikli bağlantıları döndürür.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "untrustedContentHint": false,
        "consequentialHint": false
      }
    }
  ]
}
